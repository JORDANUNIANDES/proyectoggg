@{
    ViewData["Title"] = "Acceso Denegado";
}

<div class="row justify-content-center py-5">
    <div class="col-md-6 text-center">
        <div class="card card-mh p-5 border border-danger">
            <div class="fs-1 text-danger mb-4">
                <i class="bi bi-shield-slash-fill"></i>
            </div>
            <h2 class="fw-bold text-orange mb-3">Acceso Denegado</h2>
            <p class="text-light fs-5 mb-4">
                No tienes los permisos o la autorización necesaria para acceder a esta sección de **MUSCLE HOUSE**.
            </p>
            <p class="text-gray small mb-4">
                Si crees que esto es un error, por favor contacta con el administrador del sistema.
            </p>
            <div>
                <a asp-controller="Home" asp-action="Index" class="btn btn-mh-orange px-4 py-2">
                    <i class="bi bi-house-door"></i> Volver al Inicio
                </a>
            </div>
        </div>
    </div>
</div>
