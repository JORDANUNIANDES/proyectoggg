@model MuscleHouse.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Crear Cuenta Pública";
}

<div class="row justify-content-center py-5">
    <div class="col-md-7 col-lg-6">
        <div class="card card-dark p-4">
            <div class="text-center mb-4">
                <h2 class="fw-bold text-red">MUSCLE <span class="text-light">HOUSE</span></h2>
                <p class="text-secondary m-0">Regístrate gratis para comenzar tu transformación</p>
            </div>

            <form asp-action="Register" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Nombre" class="form-label text-light fw-semibold">Nombre</label>
                        <input asp-for="Nombre" class="form-control form-control-dark" placeholder="Juan" required />
                        <span asp-validation-for="Nombre" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Apellido" class="form-label text-light fw-semibold">Apellido</label>
                        <input asp-for="Apellido" class="form-control form-control-dark" placeholder="Pérez" required />
                        <span asp-validation-for="Apellido" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label text-light fw-semibold">Correo Electrónico</label>
                        <input asp-for="Email" class="form-control form-control-dark" type="email" placeholder="correo@ejemplo.com" required />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Telefono" class="form-label text-light fw-semibold">Teléfono</label>
                        <input asp-for="Telefono" class="form-control form-control-dark" placeholder="+503 7000-0000" required />
                        <span asp-validation-for="Telefono" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="FechaNacimiento" class="form-label text-light fw-semibold">Fecha de Nacimiento</label>
                        <input asp-for="FechaNacimiento" type="date" class="form-control form-control-dark" required />
                        <span asp-validation-for="FechaNacimiento" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Objetivo" class="form-label text-light fw-semibold">Objetivo Fitness</label>
                        <input asp-for="Objetivo" class="form-control form-control-dark" placeholder="Ganar músculo / Perder peso" required />
                        <span asp-validation-for="Objetivo" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Password" class="form-label text-light fw-semibold">Contraseña</label>
                        <input asp-for="Password" type="password" class="form-control form-control-dark" placeholder="••••••••" required />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ConfirmPassword" class="form-label text-light fw-semibold">Confirmar Contraseña</label>
                        <input asp-for="ConfirmPassword" type="password" class="form-control form-control-dark" placeholder="••••••••" required />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <div class="col-12 mt-4">
                        <button type="submit" class="btn btn-muscle w-100 py-2.5">
                            <i class="bi bi-person-plus me-1"></i>Crear Mi Cuenta Gratis
                        </button>
                    </div>

                    <div class="col-12 text-center mt-3">
                        <p class="text-secondary small m-0">
                            ¿Ya tienes una cuenta?
                            <a asp-action="Login" class="text-red fw-bold text-decoration-none ms-1">Inicia Sesión aquí</a>
                        </p>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
