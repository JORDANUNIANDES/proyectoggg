@model IEnumerable<MuscleHouse.Models.Asistencia>
@{
    ViewData["Title"] = "Asistencias - Recepción";
    var clients = ViewBag.Clientes as IEnumerable<MuscleHouse.Models.Cliente> ?? new List<MuscleHouse.Models.Cliente>();
    string search = ViewBag.Search as string ?? "";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalItems = ViewBag.TotalItems ?? 0;
    int pageSize = ViewBag.PageSize ?? 10;
    int startItem = totalItems == 0 ? 0 : ((currentPage - 1) * pageSize) + 1;
    int endItem = Math.Min(currentPage * pageSize, totalItems);
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-calendar-check me-2"></i>Control de Asistencias</h2>
    <button type="button" class="btn btn-muscle" data-bs-toggle="modal" data-bs-target="#asistenciaModal">
        <i class="bi bi-person-check me-1"></i>Registrar Asistencia
    </button>
</div>

<!-- Modal Registrar Asistencia -->
<div class="modal fade" id="asistenciaModal" tabindex="-1" aria-labelledby="asistenciaModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content bg-dark text-white border-secondary">
            <div class="modal-header border-secondary">
                <h5 class="modal-title" id="asistenciaModalLabel"><i class="bi bi-check-circle me-2 text-warning"></i>Check-in de Cliente</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="RegistrarAsistencia" method="post">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Seleccionar Cliente</label>
                        <select name="clienteId" class="form-select form-control-dark" required>
                            <option value="">-- Buscar Cliente --</option>
                            @foreach (var c in clients)
                            {
                                <option value="@c.Id">@c.Nombre @c.Apellido (@c.Telefono)</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-muscle">Marcar Entrada</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Search Card -->
<div class="card card-dark p-3 mb-4">
    <form method="get" asp-action="Asistencias" class="row g-2 align-items-center">
        <div class="col-md-8">
            <div class="input-group">
                <span class="input-group-text bg-dark border-secondary text-muted"><i class="bi bi-search"></i></span>
                <input type="text" name="search" value="@search" class="form-control form-control-dark" placeholder="Buscar por cliente o teléfono..." />
            </div>
        </div>
        <div class="col-md-4 d-flex gap-2">
            <button type="submit" class="btn btn-muscle flex-grow-1">
                <i class="bi bi-search me-1"></i>Buscar
            </button>
            <a asp-action="Asistencias" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-counterclockwise me-1"></i>Limpiar
            </a>
        </div>
    </form>
</div>

<div class="card card-dark p-3">
    <div class="table-responsive">
        <table class="table table-dark table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Fecha y Hora</th>
                    <th>Cliente</th>
                    <th>Teléfono</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="3" class="text-center py-4 text-muted">No se encontraron asistencias que coincidan con la búsqueda.</td>
                    </tr>
                }
                else
                {
                    @foreach (var a in Model)
                    {
                        <tr>
                            <td><i class="bi bi-clock me-2 text-warning"></i>@a.FechaHora.ToString("dd/MM/yyyy hh:mm tt")</td>
                            <td><strong>@(a.Cliente != null ? $"{a.Cliente.Nombre} {a.Cliente.Apellido}" : $"Cliente #{a.ClienteId}")</strong></td>
                            <td>@(a.Cliente != null ? a.Cliente.Telefono : "-")</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination Controls -->
    @if (totalPages > 1)
    {
        <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top border-secondary">
            <small class="text-muted">Mostrando @startItem-@endItem de @totalItems registros</small>
            <nav aria-label="Navegación de páginas">
                <ul class="pagination pagination-sm m-0">
                    <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                        <a class="page-link bg-dark text-light border-secondary" asp-action="Asistencias" asp-route-search="@search" asp-route-page="@(currentPage - 1)">Anterior</a>
                    </li>
                    @for (int p = 1; p <= totalPages; p++)
                    {
                        <li class="page-item @(p == currentPage ? "active" : "")">
                            <a class="page-link @(p == currentPage ? "bg-danger border-danger text-white" : "bg-dark text-light border-secondary")" asp-action="Asistencias" asp-route-search="@search" asp-route-page="@p">@p</a>
                        </li>
                    }
                    <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                        <a class="page-link bg-dark text-light border-secondary" asp-action="Asistencias" asp-route-search="@search" asp-route-page="@(currentPage + 1)">Siguiente</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>
