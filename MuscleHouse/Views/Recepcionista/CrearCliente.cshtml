@model MuscleHouse.ViewModels.CreateClienteViewModel
@{
    ViewData["Title"] = "Registrar Cliente - Recepción";
    var trainers = ViewBag.Trainers as IEnumerable<MuscleHouse.Models.Entrenador> ?? new List<MuscleHouse.Models.Entrenador>();
    var plans = ViewBag.Plans as IEnumerable<MuscleHouse.Models.Plan> ?? new List<MuscleHouse.Models.Plan>();
}

<div class="mb-4">
    <h2><i class="bi bi-person-plus me-2"></i>Registrar Nuevo Cliente</h2>
</div>

<div class="row">
    <div class="col-md-8 col-lg-6">
        <div class="card card-dark p-4">
            <form asp-action="CrearCliente" method="post">
                <div class="mb-3">
                    <label asp-for="Email" class="form-label">Correo Electrónico</label>
                    <input asp-for="Email" type="email" class="form-control form-control-dark" required />
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label">Contraseña</label>
                    <input asp-for="Password" type="password" class="form-control form-control-dark" required />
                </div>

                <div class="mb-3">
                    <label asp-for="Nombre" class="form-label">Nombre</label>
                    <input asp-for="Nombre" class="form-control form-control-dark" required />
                </div>

                <div class="mb-3">
                    <label asp-for="Apellido" class="form-label">Apellido</label>
                    <input asp-for="Apellido" class="form-control form-control-dark" required />
                </div>

                <div class="mb-3">
                    <label asp-for="Telefono" class="form-label">Teléfono</label>
                    <input asp-for="Telefono" class="form-control form-control-dark" />
                </div>

                <div class="mb-3">
                    <label asp-for="FechaNacimiento" class="form-label">Fecha de Nacimiento</label>
                    <input asp-for="FechaNacimiento" type="date" class="form-control form-control-dark" required />
                </div>

                <div class="mb-3">
                    <label asp-for="Objetivo" class="form-label">Objetivo Fitness</label>
                    <input asp-for="Objetivo" class="form-control form-control-dark" placeholder="Ej: Ganar masa muscular / Pérdida de peso" />
                </div>

                <div class="mb-3">
                    <label asp-for="EntrenadorId" class="form-label">Asignar Entrenador Inicial (Opcional)</label>
                    <select asp-for="EntrenadorId" class="form-select form-control-dark">
                        <option value="">-- Sin Entrenador --</option>
                        @foreach (var t in trainers)
                        {
                            <option value="@t.Id">@t.Nombre @t.Apellido (@t.Especialidad)</option>
                        }
                    </select>
                </div>

                <div class="mb-4">
                    <label asp-for="PlanId" class="form-label">Plan de Membresía Inicial (Opcional)</label>
                    <select asp-for="PlanId" class="form-select form-control-dark">
                        <option value="">-- Asignar Plan Después --</option>
                        @foreach (var p in plans)
                        {
                            <option value="@p.Id">@p.Nombre - $@p.Precio.ToString("F2") (@p.DuracionDias días)</option>
                        }
                    </select>
                </div>

                <div class="d-flex justify-content-between">
                    <a asp-action="Clientes" class="btn btn-outline-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-muscle">Registrar Cliente</button>
                </div>
            </form>
        </div>
    </div>
</div>
