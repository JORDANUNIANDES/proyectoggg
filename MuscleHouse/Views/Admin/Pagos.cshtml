@model IEnumerable<MuscleHouse.Models.Pago>
@{
    ViewData["Title"] = "Consulta de Pagos - Admin";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-cash-stack me-2"></i>Historial de Pagos</h2>
</div>

<div class="card card-dark p-3">
    <div class="table-responsive">
        <table class="table table-dark table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Cliente</th>
                    <th>Monto</th>
                    <th>Método de Pago</th>
                    <th>Estado</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td>@p.Fecha.ToString("g")</td>
                        <td><strong>@(p.Cliente != null ? $"{p.Cliente.Nombre} {p.Cliente.Apellido}" : $"Cliente #{p.ClienteId}")</strong></td>
                        <td class="text-success font-monospace"><strong>$@p.Monto.ToString("F2")</strong></td>
                        <td><span class="badge bg-secondary">@p.MetodoPago</span></td>
                        <td>
                            @if (p.Estado == "Completado")
                            {
                                <span class="badge bg-success">Completado</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">@p.Estado</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
