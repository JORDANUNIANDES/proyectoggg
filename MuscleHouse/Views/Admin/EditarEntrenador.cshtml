@model MuscleHouse.Models.Entrenador
@{
    ViewData["Title"] = "Editar Entrenador - Admin";
}

<div class="mb-4">
    <h2><i class="bi bi-pencil-square me-2"></i>Editar Entrenador</h2>
</div>

<div class="row">
    <div class="col-md-8 col-lg-6">
        <div class="card card-dark p-4">
            <form asp-action="EditarEntrenador" method="post" enctype="multipart/form-data">
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="UserId" />
                <input type="hidden" asp-for="Fotografia" />

                <div class="mb-3">
                    <label asp-for="Nombre" class="form-label">Nombre</label>
                    <input asp-for="Nombre" class="form-control form-control-dark" required />
                </div>

                <div class="mb-3">
                    <label asp-for="Apellido" class="form-label">Apellido</label>
                    <input asp-for="Apellido" class="form-control form-control-dark" required />
                </div>

                <div class="mb-3">
                    <label asp-for="Especialidad" class="form-label">Especialidad</label>
                    <input asp-for="Especialidad" class="form-control form-control-dark" />
                </div>

                <div class="mb-3">
                    <label asp-for="Experiencia" class="form-label">Experiencia</label>
                    <input asp-for="Experiencia" class="form-control form-control-dark" />
                </div>

                <div class="mb-3">
                    <label asp-for="Descripcion" class="form-label">Descripción</label>
                    <textarea asp-for="Descripcion" class="form-control form-control-dark" rows="3"></textarea>
                </div>

                <div class="mb-3">
                    <label class="form-label">Fotografía Actual</label>
                    <div>
                        <img src="@(string.IsNullOrEmpty(Model.Fotografia) ? "/uploads/default-avatar.png" : Model.Fotografia)" class="img-thumbnail rounded mb-2" style="max-height: 120px;" />
                    </div>
                    <label class="form-label">Cambiar Fotografía</label>
                    <input type="file" name="fotoFile" class="form-control form-control-dark" accept=".jpg,.jpeg,.png,.webp" />
                </div>

                <div class="form-check mb-4">
                    <input asp-for="Activo" class="form-check-input" type="checkbox" id="checkActivo" />
                    <label class="form-check-label" for="checkActivo">Entrenador Activo</label>
                </div>

                <div class="d-flex justify-content-between">
                    <a asp-action="Entrenadores" class="btn btn-outline-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-muscle">Guardar Cambios</button>
                </div>
            </form>
        </div>
    </div>
</div>
