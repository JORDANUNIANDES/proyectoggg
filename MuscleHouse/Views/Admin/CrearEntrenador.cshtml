@model MuscleHouse.ViewModels.CreateEntrenadorViewModel
@{
    ViewData["Title"] = "Crear Entrenador - Admin";
}

<div class="mb-4">
    <h2><i class="bi bi-person-plus me-2"></i>Crear Nuevo Entrenador</h2>
</div>

<div class="row">
    <div class="col-md-8 col-lg-6">
        <div class="card card-dark p-4">
            <form asp-action="CrearEntrenador" method="post" enctype="multipart/form-data">
                <div class="mb-3">
                    <label asp-for="Email" class="form-label">Correo Electrónico</label>
                    <input asp-for="Email" type="email" class="form-control form-control-dark" required />
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label">Contraseña</label>
                    <input asp-for="Password" type="password" class="form-control form-control-dark" required />
                </div>

                <div class="mb-3">
                    <label asp-for="Nombre" class="form-label">Nombre</label>
                    <input asp-for="Nombre" class="form-control form-control-dark" required />
                </div>

                <div class="mb-3">
                    <label asp-for="Apellido" class="form-label">Apellido</label>
                    <input asp-for="Apellido" class="form-control form-control-dark" required />
                </div>

                <div class="mb-3">
                    <label asp-for="Especialidad" class="form-label">Especialidad</label>
                    <input asp-for="Especialidad" class="form-control form-control-dark" />
                </div>

                <div class="mb-3">
                    <label asp-for="Experiencia" class="form-label">Experiencia (Ej: 5 años)</label>
                    <input asp-for="Experiencia" class="form-control form-control-dark" />
                </div>

                <div class="mb-3">
                    <label asp-for="Descripcion" class="form-label">Descripción / Biografía</label>
                    <textarea asp-for="Descripcion" class="form-control form-control-dark" rows="3"></textarea>
                </div>

                <div class="mb-4">
                    <label class="form-label">Fotografía</label>
                    <input type="file" name="fotoFile" class="form-control form-control-dark" accept=".jpg,.jpeg,.png,.webp" />
                </div>

                <div class="d-flex justify-content-between">
                    <a asp-action="Entrenadores" class="btn btn-outline-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-muscle">Crear Entrenador</button>
                </div>
            </form>
        </div>
    </div>
</div>
