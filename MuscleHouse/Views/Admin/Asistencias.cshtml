@model IEnumerable<MuscleHouse.Models.Asistencia>
@{
    ViewData["Title"] = "Consulta de Asistencias - Admin";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-calendar-check me-2"></i>Historial de Asistencias</h2>
</div>

<div class="card card-dark p-3">
    <div class="table-responsive">
        <table class="table table-dark table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Fecha y Hora</th>
                    <th>Cliente</th>
                    <th>Teléfono</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in Model)
                {
                    <tr>
                        <td><i class="bi bi-clock me-2 text-warning"></i>@a.FechaHora.ToString("g")</td>
                        <td><strong>@(a.Cliente != null ? $"{a.Cliente.Nombre} {a.Cliente.Apellido}" : $"Cliente #{a.ClienteId}")</strong></td>
                        <td>@(a.Cliente != null ? a.Cliente.Telefono : "-")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
