@model IEnumerable<MuscleHouse.Models.Cliente>
@{
    ViewData["Title"] = "Gestión de Clientes - Admin";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-people me-2"></i>Gestión de Clientes</h2>
</div>

<div class="card card-dark p-3">
    <div class="table-responsive">
        <table class="table table-dark table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Nombre Completo</th>
                    <th>Teléfono</th>
                    <th>Fecha Nacimiento</th>
                    <th>Objetivo</th>
                    <th>Entrenador Asignado</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td><strong>@c.Nombre @c.Apellido</strong></td>
                        <td>@c.Telefono</td>
                        <td>@c.FechaNacimiento.ToShortDateString()</td>
                        <td><span class="badge bg-secondary">@c.Objetivo</span></td>
                        <td>@(c.Entrenador != null ? $"{c.Entrenador.Nombre} {c.Entrenador.Apellido}" : "Sin Entrenador")</td>
                        <td>
                            @if (c.Activo)
                            {
                                <span class="badge bg-success">Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Inactivo</span>
                            }
                        </td>
                        <td>
                            <a asp-action="EditarCliente" asp-route-id="@c.Id" class="btn btn-sm btn-outline-warning me-1">
                                <i class="bi bi-pencil"></i> Editar
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
