@model IEnumerable<MuscleHouse.Models.Recepcionista>
@{
    ViewData["Title"] = "Gestión de Recepcionistas - Admin";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-person-workspace me-2"></i>Gestión de Recepcionistas</h2>
    <a asp-action="CrearRecepcionista" class="btn btn-muscle">
        <i class="bi bi-plus-lg me-1"></i>Nuevo Recepcionista
    </a>
</div>

<div class="card card-dark p-3">
    <div class="table-responsive">
        <table class="table table-dark table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Foto</th>
                    <th>Nombre Completo</th>
                    <th>Horario Atencion</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td>
                            <img src="@(string.IsNullOrEmpty(r.Fotografia) ? "/uploads/default-avatar.png" : r.Fotografia)"
                                 class="rounded-circle" width="40" height="40" style="object-fit: cover;" alt="Foto" />
                        </td>
                        <td><strong>@r.Nombre @r.Apellido</strong></td>
                        <td><span class="badge bg-secondary">@r.HorarioAtencion</span></td>
                        <td>
                            @if (r.Activo)
                            {
                                <span class="badge bg-success">Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Inactivo</span>
                            }
                        </td>
                        <td>
                            <a asp-action="EditarRecepcionista" asp-route-id="@r.Id" class="btn btn-sm btn-outline-warning me-1">
                                <i class="bi bi-pencil"></i> Editar
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
