@model MuscleHouse.Models.Plan
@{
    ViewData["Title"] = "Editar Plan de Entrenamiento";
}

<div class="row justify-content-center py-5">
    <div class="col-md-6">
        <div class="card card-mh p-4">
            <h3 class="fw-bold text-red mb-3"><i class="bi bi-pencil-square"></i> Editar Plan de Entrenamiento</h3>
            <p class="text-gray mb-4">Modifica los detalles del plan oficial de MUSCLE HOUSE.</p>

            <form asp-action="EditarPlan" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />

                <div class="mb-3">
                    <label asp-for="Nombre" class="form-label text-red small fw-bold">Nombre del Plan</label>
                    <input asp-for="Nombre" class="form-control form-control-mh" required readonly />
                </div>

                <div class="mb-3">
                    <label asp-for="DuracionDias" class="form-label text-red small fw-bold">Duración en Días</label>
                    <input asp-for="DuracionDias" type="number" class="form-control form-control-mh" required />
                    <span asp-validation-for="DuracionDias" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Precio" class="form-label text-red small fw-bold">Precio ($)</label>
                    <input asp-for="Precio" type="number" step="0.01" class="form-control form-control-mh" required />
                    <span asp-validation-for="Precio" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Descripcion" class="form-label text-red small fw-bold">Descripción</label>
                    <textarea asp-for="Descripcion" class="form-control form-control-mh" rows="3" required></textarea>
                    <span asp-validation-for="Descripcion" class="text-danger small"></span>
                </div>

                <div class="mt-4 d-flex justify-content-between">
                    <a asp-action="Planes" class="btn btn-mh-secondary px-4">Cancelar</a>
                    <button type="submit" class="btn btn-mh-red px-4">Guardar Cambios</button>
                </div>
            </form>
        </div>
    </div>
</div>
