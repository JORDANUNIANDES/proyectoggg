@model MuscleHouse.Models.Ejercicio
@{
    ViewData["Title"] = "Crear Ejercicio";
}

<div class="row justify-content-center py-5">
    <div class="col-md-6">
        <div class="card card-mh p-4">
            <h3 class="fw-bold text-red mb-3"><i class="bi bi-plus-circle"></i> Registrar Nuevo Ejercicio</h3>
            <p class="text-gray mb-4">Agrega un ejercicio al catálogo oficial de MUSCLE HOUSE.</p>

            <form asp-action="CrearEjercicio" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label asp-for="Nombre" class="form-label text-red small fw-bold">Nombre del Ejercicio</label>
                    <input asp-for="Nombre" class="form-control form-control-mh" placeholder="ej. Curl de Bíceps" required />
                    <span asp-validation-for="Nombre" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="GrupoMuscular" class="form-label text-red small fw-bold">Grupo Muscular</label>
                    <input asp-for="GrupoMuscular" class="form-control form-control-mh" placeholder="ej. Brazos" required />
                    <span asp-validation-for="GrupoMuscular" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Descripcion" class="form-label text-red small fw-bold">Descripción</label>
                    <textarea asp-for="Descripcion" class="form-control form-control-mh" rows="3" placeholder="Descripción resumida..." required></textarea>
                    <span asp-validation-for="Descripcion" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Instrucciones" class="form-label text-red small fw-bold">Instrucciones</label>
                    <textarea asp-for="Instrucciones" class="form-control form-control-mh" rows="3" placeholder="Instrucciones de ejecución paso a paso..." required></textarea>
                    <span asp-validation-for="Instrucciones" class="text-danger small"></span>
                </div>

                <div class="mt-4 d-flex justify-content-between">
                    <a asp-action="Ejercicios" class="btn btn-mh-secondary px-4">Cancelar</a>
                    <button type="submit" class="btn btn-mh-red px-4">Crear Ejercicio</button>
                </div>
            </form>
        </div>
    </div>
</div>
