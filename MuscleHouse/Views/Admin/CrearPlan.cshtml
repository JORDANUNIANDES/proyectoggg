@model MuscleHouse.Models.Plan
@{
    ViewData["Title"] = "Crear Nuevo Plan";
}

<div class="row justify-content-center py-5">
    <div class="col-md-6">
        <div class="card card-dark p-4">
            <h3 class="fw-bold text-red mb-3"><i class="bi bi-tag-fill me-2"></i>Crear Nuevo Plan de Entrenamiento</h3>
            <p class="text-secondary mb-4">Define los parámetros del nuevo plan oficial para MUSCLE HOUSE.</p>

            <form asp-action="CrearPlan" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Nombre" class="form-label text-light fw-semibold">Nombre del Plan</label>
                    <input asp-for="Nombre" class="form-control form-control-dark" placeholder="Ej: Trimestral Pro / Especial Verano" required />
                    <span asp-validation-for="Nombre" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="DuracionDias" class="form-label text-light fw-semibold">Duración en Días</label>
                    <input asp-for="DuracionDias" type="number" class="form-control form-control-dark" placeholder="Ej: 30, 90, 180, 365" required />
                    <span asp-validation-for="DuracionDias" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Precio" class="form-label text-light fw-semibold">Precio ($)</label>
                    <input asp-for="Precio" type="number" step="0.01" class="form-control form-control-dark" placeholder="Ej: 45.00" required />
                    <span asp-validation-for="Precio" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Descripcion" class="form-label text-light fw-semibold">Descripción</label>
                    <textarea asp-for="Descripcion" class="form-control form-control-dark" rows="3" placeholder="Descripción detallada de los beneficios del plan..." required></textarea>
                    <span asp-validation-for="Descripcion" class="text-danger small"></span>
                </div>

                <div class="mt-4 d-flex justify-content-between">
                    <a asp-action="Planes" class="btn btn-outline-secondary px-4">Cancelar</a>
                    <button type="submit" class="btn btn-muscle px-4"><i class="bi bi-check-circle me-1"></i>Guardar Plan</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
