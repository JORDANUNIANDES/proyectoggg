@model MuscleHouse.Models.Cliente
@{
    ViewData["Title"] = "Editar Cliente - Admin";
    var trainers = ViewBag.Trainers as IEnumerable<MuscleHouse.Models.Entrenador> ?? new List<MuscleHouse.Models.Entrenador>();
}

<div class="mb-4">
    <h2><i class="bi bi-pencil-square me-2"></i>Editar Cliente</h2>
</div>

<div class="row">
    <div class="col-md-8 col-lg-6">
        <div class="card card-dark p-4">
            <form asp-action="EditarCliente" method="post">
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="UserId" />

                <div class="mb-3">
                    <label asp-for="Nombre" class="form-label">Nombre</label>
                    <input asp-for="Nombre" class="form-control form-control-dark" required />
                </div>

                <div class="mb-3">
                    <label asp-for="Apellido" class="form-label">Apellido</label>
                    <input asp-for="Apellido" class="form-control form-control-dark" required />
                </div>

                <div class="mb-3">
                    <label asp-for="Telefono" class="form-label">Teléfono</label>
                    <input asp-for="Telefono" class="form-control form-control-dark" />
                </div>

                <div class="mb-3">
                    <label asp-for="FechaNacimiento" class="form-label">Fecha de Nacimiento</label>
                    <input asp-for="FechaNacimiento" type="date" class="form-control form-control-dark" />
                </div>

                <div class="mb-3">
                    <label asp-for="Objetivo" class="form-label">Objetivo</label>
                    <input asp-for="Objetivo" class="form-control form-control-dark" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Entrenador Asignado</label>
                    <select name="entrenadorId" class="form-select form-control-dark">
                        <option value="">-- Sin Entrenador --</option>
                        @foreach (var t in trainers)
                        {
                            if (Model.EntrenadorId == t.Id)
                            {
                                <option value="@t.Id" selected="selected">@t.Nombre @t.Apellido (@t.Especialidad)</option>
                            }
                            else
                            {
                                <option value="@t.Id">@t.Nombre @t.Apellido (@t.Especialidad)</option>
                            }
                        }
                    </select>
                </div>

                <div class="form-check mb-4">
                    <input asp-for="Activo" class="form-check-input" type="checkbox" id="checkActivo" />
                    <label class="form-check-label" for="checkActivo">Cliente Activo</label>
                </div>

                <div class="d-flex justify-content-between">
                    <a asp-action="Clientes" class="btn btn-outline-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-muscle">Guardar Cambios</button>
                </div>
            </form>
        </div>
    </div>
</div>
