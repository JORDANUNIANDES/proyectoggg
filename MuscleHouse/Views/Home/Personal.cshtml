@{
    ViewData["Title"] = "Nuestro Personal";
    var trainers = ViewBag.Trainers as IEnumerable<MuscleHouse.Models.Entrenador> ?? new List<MuscleHouse.Models.Entrenador>();
    var receptionists = ViewBag.Receptionists as IEnumerable<MuscleHouse.Models.Recepcionista> ?? new List<MuscleHouse.Models.Recepcionista>();
}

<div class="mb-5 text-center">
    <h2 class="display-5 fw-bold text-orange">Nuestro Personal — MUSCLE HOUSE</h2>
    <p class="text-gray col-md-8 mx-auto">
        Conoce a los profesionales certificados dedicados a ayudarte a alcanzar tus metas físicas de forma segura y consistente.
    </p>
</div>

<!-- Trainers section -->
<div class="mb-5">
    <h3 class="fw-bold text-yellow border-bottom border-secondary pb-2 mb-4">
        <i class="bi bi-person-workspace"></i> Entrenadores Personales
    </h3>
    <div class="row g-4">
        @if (trainers.Any())
        {
            @foreach (var trainer in trainers)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card card-mh h-100 overflow-hidden">
                        <div class="bg-dark text-center p-3" style="min-height: 200px; display: flex; align-items: center; justify-content: center;">
                            <img src="@(string.IsNullOrEmpty(trainer.Fotografia) ? "/uploads/default-avatar.png" : trainer.Fotografia)"
                                 alt="@trainer.Nombre" class="rounded-circle border border-warning" style="width: 120px; height: 120px; object-fit: cover;" />
                        </div>
                        <div class="card-body">
                            <h4 class="card-title fw-bold text-orange">@trainer.Nombre @trainer.Apellido</h4>
                            <p class="text-yellow small m-0 mb-2">⭐ Especialidad: <strong>@trainer.Especialidad</strong></p>
                            <p class="text-light small m-0 mb-3">📅 Experiencia: <strong>@trainer.Experiencia años</strong></p>
                            <p class="card-text text-gray small">@trainer.Descripcion</p>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <p class="text-gray italic">No hay entrenadores registrados en este momento.</p>
            </div>
        }
    </div>
</div>

<!-- Receptionists section -->
<div>
    <h3 class="fw-bold text-yellow border-bottom border-secondary pb-2 mb-4">
        <i class="bi bi-person-vcard"></i> Recepción y Soporte
    </h3>
    <div class="row g-4">
        @if (receptionists.Any())
        {
            @foreach (var recep in receptionists)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card card-mh h-100 overflow-hidden">
                        <div class="bg-dark text-center p-3" style="min-height: 200px; display: flex; align-items: center; justify-content: center;">
                            <img src="@(string.IsNullOrEmpty(recep.Fotografia) ? "/uploads/default-avatar.png" : recep.Fotografia)"
                                 alt="@recep.Nombre" class="rounded-circle border border-warning" style="width: 120px; height: 120px; object-fit: cover;" />
                        </div>
                        <div class="card-body">
                            <h4 class="card-title fw-bold text-orange">@recep.Nombre @recep.Apellido</h4>
                            <p class="text-yellow small m-0 mb-2">🕒 Horario: <strong>@recep.HorarioAtencion</strong></p>
                            <p class="card-text text-gray small">@recep.Descripcion</p>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <p class="text-gray italic">No hay recepcionistas registrados en este momento.</p>
            </div>
        }
    </div>
</div>
