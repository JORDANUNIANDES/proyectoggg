@model MuscleHouse.ViewModels.ClienteDashboardViewModel
@{
    ViewData["Title"] = "Mi Perfil de Entrenamiento";
    var latestProgress = Model.HistorialProgreso.OrderByDescending(p => p.Fecha).FirstOrDefault();
}

<div class="mb-4">
    <h2 class="fw-bold text-red"><i class="bi bi-speedometer2 me-2"></i>Mi Dashboard — MUSCLE HOUSE</h2>
    <p class="text-secondary">¡Bienvenido de vuelta, <strong>@Model.Cliente?.Nombre</strong>! Aquí tienes un análisis interactivo de tu evolución física en MUSCLE HOUSE.</p>
</div>

<!-- KPI Cards -->
<div class="row g-4 mb-5">
    <div class="col-md-4">
        <div class="card card-dark p-4 text-center">
            <h6 class="text-muted small text-uppercase m-0 fw-bold">Estado de Membresía</h6>
            <h3 class="fw-bold text-red mt-2">@(Model.MembresiaActual?.Plan?.Nombre ?? "Ninguna")</h3>
            <p class="text-secondary small m-0 mt-1">Días restantes: <strong class="text-light">@Model.DiasRestantes</strong></p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card card-dark p-4 text-center">
            <h6 class="text-muted small text-uppercase m-0 fw-bold">Mi Entrenador Asignado</h6>
            <h3 class="fw-bold text-light mt-2">@(Model.Entrenador != null ? $"{Model.Entrenador.Nombre} {Model.Entrenador.Apellido}" : "Sin Asignar")</h3>
            <p class="text-secondary small m-0 mt-1">@Model.Entrenador?.Especialidad</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card card-dark p-4 text-center">
            <h6 class="text-muted small text-uppercase m-0 fw-bold">Rutina Activa</h6>
            <h3 class="fw-bold text-light mt-2">@(Model.RutinaActiva?.Nombre ?? "Ninguna")</h3>
            <p class="text-secondary small m-0 mt-1">@Model.RutinaActiva?.FechaCreacion.ToString("dd/MM/yyyy")</p>
        </div>
    </div>
</div>

<!-- Medidas Fisicas Charts -->
<div class="row g-4 mb-5">
    <div class="col-md-12">
        <div class="card card-dark">
            <div class="card-mh-header text-red"><i class="bi bi-graph-up me-2"></i>Mi Evolución de Medidas Físicas y Peso</div>
            <div class="card-body" style="height: 350px; display: flex; align-items: center; justify-content: center;">
                @if (Model.HistorialProgreso.Any())
                {
                    <canvas id="evolucionChart" style="max-height: 320px;"></canvas>
                }
                else
                {
                    <p class="text-muted m-0 italic">No has registrado medidas físicas de progreso todavía.</p>
                }
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Active Routine Details -->
    <div class="col-md-6">
        <div class="card card-dark h-100">
            <div class="card-mh-header text-red"><i class="bi bi-list-task me-2"></i>Mi Rutina Activa</div>
            <div class="card-body p-0">
                @if (Model.RutinaActiva != null && Model.RutinaActiva.RutinaEjercicios.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-dark w-100 m-0">
                            <thead>
                                <tr>
                                    <th>Ejercicio</th>
                                    <th>Series</th>
                                    <th>Reps</th>
                                    <th>Peso Rec.</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.RutinaActiva.RutinaEjercicios)
                                {
                                    <tr>
                                        <td><strong>@item.Ejercicio?.Nombre</strong></td>
                                        <td>@item.Series</td>
                                        <td>@item.Repeticiones</td>
                                        <td class="text-red fw-bold">@item.PesoRecomendado.ToString("F1") kg</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="p-4 text-center">
                        <p class="text-muted m-0 italic">No tienes rutinas activas asignadas. Solicita una a tu entrenador.</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Self register progress form -->
    <div class="col-md-6">
        <div class="card card-dark h-100">
            <div class="card-mh-header text-red"><i class="bi bi-plus-circle me-2"></i>Registrar Mis Medidas de Hoy</div>
            <div class="card-body">
                <form asp-action="RegistrarProgresoPropio" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="ClienteId" value="@Model.Cliente?.Id" />

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label text-red small fw-bold">Peso actual (kg)</label>
                            <input type="number" step="0.01" name="Peso" class="form-control form-control-dark" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-red small fw-bold">Pecho (cm)</label>
                            <input type="number" step="0.1" name="Pecho" class="form-control form-control-dark" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-red small fw-bold">Cintura (cm)</label>
                            <input type="number" step="0.1" name="Cintura" class="form-control form-control-dark" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-red small fw-bold">Brazo (cm)</label>
                            <input type="number" step="0.1" name="Brazo" class="form-control form-control-dark" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-red small fw-bold">Pierna (cm)</label>
                            <input type="number" step="0.1" name="Pierna" class="form-control form-control-dark" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-red small fw-bold">Cadera (cm)</label>
                            <input type="number" step="0.1" name="Cadera" class="form-control form-control-dark" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label text-red small fw-bold">Observaciones / Rendimiento</label>
                            <input type="text" name="Observaciones" class="form-control form-control-dark" placeholder="ej. Sintiendo más fuerza en empujes." />
                        </div>
                        <div class="col-12 mt-4 text-end">
                            <button type="submit" class="btn btn-muscle px-4">
                                <i class="bi bi-check-circle me-1"></i>Guardar Medidas de Progreso
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        $(document).ready(function() {
            @if (Model.HistorialProgreso.Any())
            {
                var sortedProgress = Model.HistorialProgreso.OrderBy(p => p.Fecha).ToList();
                var dates = sortedProgress.Select(p => p.Fecha.ToString("dd/MM")).ToList();
                var weights = sortedProgress.Select(p => p.Peso).ToList();
                var arms = sortedProgress.Select(p => p.Brazo).ToList();
                var waists = sortedProgress.Select(p => p.Cintura).ToList();
                <text>
                var ctx = document.getElementById('evolucionChart').getContext('2d');
                new Chart(ctx, {
                    type: 'line',
                    data: {
                        labels: @Html.Raw(Json.Serialize(dates)),
                        datasets: [
                            {
                                label: 'Peso (kg)',
                                data: @Html.Raw(Json.Serialize(weights)),
                                borderColor: '#E31C25',
                                backgroundColor: 'rgba(227, 28, 37, 0.15)',
                                tension: 0.2,
                                yAxisID: 'y'
                            },
                            {
                                label: 'Brazo (cm)',
                                data: @Html.Raw(Json.Serialize(arms)),
                                borderColor: '#F5F5F5',
                                backgroundColor: 'transparent',
                                tension: 0.2,
                                yAxisID: 'y1'
                            },
                            {
                                label: 'Cintura (cm)',
                                data: @Html.Raw(Json.Serialize(waists)),
                                borderColor: '#D0D3D6',
                                backgroundColor: 'transparent',
                                tension: 0.2,
                                yAxisID: 'y1'
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                labels: { color: '#F5F5F5', font: { family: 'Inter', size: 12 } }
                            }
                        },
                        scales: {
                            x: {
                                ticks: { color: '#D0D3D6' },
                                grid: { color: '#2A2D30' }
                            },
                            y: {
                                type: 'linear',
                                display: true,
                                position: 'left',
                                title: { display: true, text: 'Cargas / Peso (kg)', color: '#E31C25' },
                                ticks: { color: '#D0D3D6' },
                                grid: { color: '#2A2D30' }
                            },
                            y1: {
                                type: 'linear',
                                display: true,
                                position: 'right',
                                title: { display: true, text: 'Medidas (cm)', color: '#F5F5F5' },
                                ticks: { color: '#D0D3D6' },
                                grid: { drawOnChartArea: false }
                            }
                        }
                    }
                });
                </text>
            }
        });
    </script>
}
