@model IEnumerable<MuscleHouse.Models.Membresia>
@{
    ViewData["Title"] = "Mi Membresía - MUSCLE HOUSE";
    var activeSub = Model.FirstOrDefault(m => m.Estado == "Activa");
}

<div class="mb-4">
    <h2><i class="bi bi-card-heading me-2"></i>Mi Membresía</h2>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-6">
        <div class="card card-dark p-4 border-warning">
            <h5 class="text-warning mb-3">Membresía Actual</h5>
            @if (activeSub != null)
            {
                <h3 class="fw-bold">@activeSub.Plan?.Nombre</h3>
                <p><strong>Fecha de Inicio:</strong> @activeSub.FechaInicio.ToShortDateString()</p>
                <p><strong>Fecha de Vencimiento:</strong> @activeSub.FechaVencimiento.ToShortDateString()</p>
                <div class="alert bg-dark text-success border-success mt-3 mb-0">
                    <i class="bi bi-check-circle me-2"></i>Estado: <strong>@activeSub.Estado</strong>
                </div>
            }
            else
            {
                <div class="alert bg-dark text-danger border-danger mb-0">
                    <i class="bi bi-exclamation-triangle me-2"></i>No tienes una membresía activa en este momento. Acércate a recepción para adquirir una.
                </div>
            }
        </div>
    </div>
</div>

<div class="card card-dark p-3">
    <h5 class="text-warning mb-3">Historial de Membresías</h5>
    <div class="table-responsive">
        <table class="table table-dark table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Plan</th>
                    <th>Fecha Inicio</th>
                    <th>Fecha Vencimiento</th>
                    <th>Precio Pagado</th>
                    <th>Estado</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in Model)
                {
                    <tr>
                        <td><strong>@(m.Plan != null ? m.Plan.Nombre : "N/A")</strong></td>
                        <td>@m.FechaInicio.ToShortDateString()</td>
                        <td>@m.FechaVencimiento.ToShortDateString()</td>
                        <td>$@m.PrecioPagado.ToString("F2")</td>
                        <td>
                            @if (m.Estado == "Activa")
                            {
                                <span class="badge bg-success">Activa</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">@m.Estado</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
