@model IEnumerable<MuscleHouse.Models.Asistencia>
@{
    ViewData["Title"] = "Mis Asistencias - MUSCLE HOUSE";
}

<div class="mb-4">
    <h2><i class="bi bi-calendar-check me-2"></i>Mis Asistencias</h2>
</div>

<div class="card card-dark p-3">
    <div class="table-responsive">
        <table class="table table-dark table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Fecha y Hora</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in Model)
                {
                    <tr>
                        <td><i class="bi bi-clock me-2 text-warning"></i>@a.FechaHora.ToString("f")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
