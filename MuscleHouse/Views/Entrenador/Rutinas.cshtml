@model IEnumerable<MuscleHouse.Models.Rutina>
@{
    ViewData["Title"] = "Rutinas Creadas - Entrenador";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-journal-text me-2"></i>Rutinas Diseñadas</h2>
</div>

<div class="card card-dark p-3">
    <div class="table-responsive">
        <table class="table table-dark table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Nombre Rutina</th>
                    <th>Cliente</th>
                    <th>Fecha Creación</th>
                    <th>Ejercicios</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td><strong>@r.Nombre</strong></td>
                        <td>@(r.Cliente != null ? $"{r.Cliente.Nombre} {r.Cliente.Apellido}" : $"Cliente #{r.ClienteId}")</td>
                        <td>@r.FechaCreacion.ToShortDateString()</td>
                        <td><span class="badge bg-secondary">@(r.RutinaEjercicios?.Count ?? 0) Ejercicios</span></td>
                        <td>
                            @if (r.Activa)
                            {
                                <span class="badge bg-success">Activa</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Inactiva</span>
                            }
                        </td>
                        <td>
                            <a asp-action="ClienteDetalles" asp-route-id="@r.ClienteId" class="btn btn-sm btn-outline-warning">
                                <i class="bi bi-eye"></i> Ver Cliente
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
