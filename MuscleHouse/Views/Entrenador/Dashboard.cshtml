@model MuscleHouse.ViewModels.EntrenadorDashboardViewModel
@{
    ViewData["Title"] = "Panel del Entrenador";
}

<div class="mb-4">
    <h2 class="fw-bold text-orange"><i class="bi bi-speedometer2"></i> Dashboard Entrenador — MUSCLE HOUSE</h2>
    <p class="text-gray">Bienvenido al Panel de Control de Coach de MUSCLE HOUSE.</p>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-12">
        <div class="card card-mh p-4 text-center">
            <h5 class="text-gray small text-uppercase">Clientes Asignados Activos</h5>
            <h2 class="display-5 fw-bold text-orange">@Model.TotalClientesAsignados</h2>
        </div>
    </div>
</div>

<div class="card card-mh mb-4">
    <div class="card-mh-header text-orange">👥 Mis Clientes Asignados</div>
    <div class="card-body">
        @if (Model.ClientesAsignados.Any())
        {
            <div class="table-responsive">
                <table class="table table-mh w-100 m-0">
                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>Teléfono</th>
                            <th>Objetivo</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var client in Model.ClientesAsignados)
                        {
                            <tr>
                                <td>@client.Nombre @client.Apellido</td>
                                <td>@client.Telefono</td>
                                <td>@client.Objetivo</td>
                                <td>
                                    <a asp-action="ClienteDetalles" asp-route-id="@client.Id" class="btn btn-sm btn-mh-orange">
                                        <i class="bi bi-eye"></i> Ver Perfil / Diseñar Rutina
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="text-gray m-0 italic">No tienes clientes asignados activos en este momento.</p>
        }
    </div>
</div>
