@model AgenciaPublicidad.Models.Disenador

@{
    ViewData["Title"] = "Registrar Diseñador";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-warning text-white py-3">
                <h4 class="card-title mb-0 fw-bold">🆕 Registrar Diseñador</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="nombre" class="form-label fw-bold"></label>
                        <input asp-for="nombre" class="form-control" placeholder="Ej. Carlos Silva" />
                        <span asp-validation-for="nombre" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="especialidad" class="form-label fw-bold"></label>
                        <input asp-for="especialidad" class="form-control" placeholder="Ej. Branding, UI/UX, Web" />
                        <span asp-validation-for="especialidad" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="email" class="form-label fw-bold"></label>
                        <input asp-for="email" class="form-control" placeholder="Ej. carlos@agencia.com" />
                        <span asp-validation-for="email" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="telefono" class="form-label fw-bold"></label>
                        <input asp-for="telefono" class="form-control" placeholder="Ej. +56999887766" />
                        <span asp-validation-for="telefono" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-4">
                        <a asp-action="Index" class="btn btn-secondary px-4">⬅️ Volver al Listado</a>
                        <button type="submit" class="btn btn-warning text-white px-4">💾 Guardar Diseñador</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
