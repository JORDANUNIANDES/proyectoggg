@model AgenciaPublicidad.Models.Entregable

@{
    ViewData["Title"] = "Detalles de Entregable";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-info text-white py-3">
                <h4 class="card-title mb-0 fw-bold">👁️ Detalles de Entregable</h4>
            </div>
            <div class="card-body p-4">
                <dl class="row">
                    <dt class="col-sm-4 fw-bold text-secondary">ID de Entregable</dt>
                    <dd class="col-sm-8 text-dark fw-bold">@Model.entregable_id</dd>

                    <dt class="col-sm-4 fw-bold text-secondary">Campaña</dt>
                    <dd class="col-sm-8 text-dark fw-bold">@(Model.Campana?.nombre ?? "N/A")</dd>

                    <dt class="col-sm-4 fw-bold text-secondary">Diseñador Asignado</dt>
                    <dd class="col-sm-8">@(Model.Disenador?.nombre ?? "N/A")</dd>

                    <dt class="col-sm-4 fw-bold text-secondary">Tipo de Entregable</dt>
                    <dd class="col-sm-8"><span class="badge bg-secondary p-2">@Model.tipo</span></dd>

                    <dt class="col-sm-4 fw-bold text-secondary">Fecha de Entrega</dt>
                    <dd class="col-sm-8">@Model.fecha_entrega.ToString("dd/MM/yyyy")</dd>
                </dl>

                <div class="d-flex justify-content-between align-items-center mt-4 border-top pt-3">
                    <a asp-action="Index" class="btn btn-secondary px-4">⬅️ Volver al Listado</a>
                    <a asp-action="Edit" asp-route-id="@Model.entregable_id" class="btn btn-warning text-white px-4">✏️ Editar</a>
                </div>
            </div>
        </div>
    </div>
</div>
