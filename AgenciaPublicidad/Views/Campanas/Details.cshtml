@model AgenciaPublicidad.Models.Campana

@{
    ViewData["Title"] = "Detalles de Campaña";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-info text-white py-3">
                <h4 class="card-title mb-0 fw-bold">👁️ Detalles de Campaña</h4>
            </div>
            <div class="card-body p-4">
                <dl class="row">
                    <dt class="col-sm-4 fw-bold text-secondary">ID de Campaña</dt>
                    <dd class="col-sm-8 text-dark fw-bold">@Model.campana_id</dd>

                    <dt class="col-sm-4 fw-bold text-secondary">Nombre de Campaña</dt>
                    <dd class="col-sm-8 text-dark fw-bold">@Model.nombre</dd>

                    <dt class="col-sm-4 fw-bold text-secondary">Cliente</dt>
                    <dd class="col-sm-8">@(Model.Cliente?.nombre_empresa ?? "N/A")</dd>

                    <dt class="col-sm-4 fw-bold text-secondary">Presupuesto</dt>
                    <dd class="col-sm-8 text-success fw-bold">@Model.presupuesto.ToString("C")</dd>

                    <dt class="col-sm-4 fw-bold text-secondary">Fecha de Inicio</dt>
                    <dd class="col-sm-8">@Model.fecha_inicio.ToString("dd/MM/yyyy")</dd>
                </dl>

                <div class="d-flex justify-content-between align-items-center mt-4 border-top pt-3">
                    <a asp-action="Index" class="btn btn-secondary px-4">⬅️ Volver al Listado</a>
                    <a asp-action="Edit" asp-route-id="@Model.campana_id" class="btn btn-warning text-white px-4">✏️ Editar</a>
                </div>
            </div>
        </div>
    </div>
</div>
