@model AgenciaPublicidad.Models.Campana

@{
    ViewData["Title"] = "Editar Campaña";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-warning text-white py-3">
                <h4 class="card-title mb-0 fw-bold">✏️ Editar Campaña</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input type="hidden" asp-for="campana_id" />

                    <div class="mb-3">
                        <label asp-for="cliente_id" class="form-label fw-bold">Cliente</label>
                        <select asp-for="cliente_id" class="form-select" asp-items="ViewBag.cliente_id"></select>
                        <span asp-validation-for="cliente_id" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="nombre" class="form-label fw-bold"></label>
                        <input asp-for="nombre" class="form-control" />
                        <span asp-validation-for="nombre" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="presupuesto" class="form-label fw-bold"></label>
                        <input asp-for="presupuesto" type="number" step="0.01" class="form-control" />
                        <span asp-validation-for="presupuesto" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="fecha_inicio" class="form-label fw-bold"></label>
                        <input asp-for="fecha_inicio" type="date" class="form-control" value="@Model.fecha_inicio.ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="fecha_inicio" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-4">
                        <a asp-action="Index" class="btn btn-secondary px-4">⬅️ Cancelar</a>
                        <button type="submit" class="btn btn-warning text-white px-4">💾 Guardar Cambios</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
