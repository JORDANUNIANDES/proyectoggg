@model IEnumerable<AgenciaPublicidad.Models.Campana>

@{
    ViewData["Title"] = "Campañas";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="text-success fw-bold">Campañas</h1>
    <a asp-action="Create" class="btn btn-success">🆕 Registrar Campaña</a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped mb-0 align-middle">
                <thead class="table-dark">
                    <tr>
                        <th scope="col" style="width: 80px;">ID</th>
                        <th scope="col">Nombre</th>
                        <th scope="col">Cliente</th>
                        <th scope="col">Presupuesto</th>
                        <th scope="col">Fecha de Inicio</th>
                        <th scope="col" class="text-center" style="width: 250px;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">No hay campañas registradas en el sistema.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <th scope="row" class="fw-bold text-secondary">@item.campana_id</th>
                                <td class="fw-bold text-dark">@item.nombre</td>
                                <td>@(item.Cliente?.nombre_empresa ?? "N/A")</td>
                                <td class="fw-bold text-success">@item.presupuesto.ToString("C")</td>
                                <td>@item.fecha_inicio.ToString("dd/MM/yyyy")</td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a asp-action="Edit" asp-route-id="@item.campana_id" class="btn btn-warning text-white">✏️ Editar</a>
                                        <a asp-action="Details" asp-route-id="@item.campana_id" class="btn btn-info text-white">👁️ Detalles</a>
                                        <a asp-action="Delete" asp-route-id="@item.campana_id" class="btn btn-danger">🗑️ Eliminar</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
