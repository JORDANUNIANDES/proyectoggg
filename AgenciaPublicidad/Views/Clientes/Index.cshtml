@model IEnumerable<AgenciaPublicidad.Models.Cliente>

@{
    ViewData["Title"] = "Clientes";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="text-primary fw-bold">Clientes</h1>
    <a asp-action="Create" class="btn btn-primary">🆕 Registrar Cliente</a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped mb-0 align-middle">
                <thead class="table-dark">
                    <tr>
                        <th scope="col" style="width: 80px;">ID</th>
                        <th scope="col">Nombre de Empresa</th>
                        <th scope="col">Contacto</th>
                        <th scope="col">Teléfono</th>
                        <th scope="col">Email</th>
                        <th scope="col" class="text-center" style="width: 250px;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">No hay clientes registrados en el sistema.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <th scope="row" class="fw-bold text-secondary">@item.cliente_id</th>
                                <td class="fw-bold text-dark">@item.nombre_empresa</td>
                                <td>@item.contacto</td>
                                <td>@item.telefono</td>
                                <td>@item.email</td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a asp-action="Edit" asp-route-id="@item.cliente_id" class="btn btn-warning text-white">✏️ Editar</a>
                                        <a asp-action="Details" asp-route-id="@item.cliente_id" class="btn btn-info text-white">👁️ Detalles</a>
                                        <a asp-action="Delete" asp-route-id="@item.cliente_id" class="btn btn-danger">🗑️ Eliminar</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
